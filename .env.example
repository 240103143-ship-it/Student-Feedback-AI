# Copy this file to .env and adjust as needed. start.ps1 creates .env
# automatically (with a random JWT_SECRET) if it does not exist yet.

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# Signs the login session tokens (JWT). start.ps1 generates a random value here.
JWT_SECRET=change-me-in-production
JWT_HOURS=8
JWT_REMEMBER_HOURS=168

MAX_LOGIN_ATTEMPTS=5
LOCK_SECONDS=30

# Creates demo departments + one account per role (student/faculty/manager/admin)
# on first startup. Password for all demo accounts: Pulse#2026
SEED_DEMO_DATA=true
DEMO_PASSWORD=Pulse#2026

CORS_ORIGINS=http://localhost:8080

BACKEND_PORT=8000
FRONTEND_PORT=8080
# Postgres port on your machine (127.0.0.1 only) — connect a GUI client here to inspect the DB
DB_PORT=5433

# Optional (story 4.1): an Anthropic API key lets managers rewrite the feedback summary
# with Claude. Without it the built-in summary is used. Comments are sent only after
# personal data has been removed.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
